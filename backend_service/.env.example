PORT=3000
DOMAIN=http://localhost:3000

# Stripe Credentials
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=

# Trigger.dev Worker Key
TRIGGER_SECRET_KEY=

# Supabase Credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# OpenRouter: every language model call (the document scanner and Prohori chat).
# Free models only. The key is at https://openrouter.ai/keys; keep it out of git.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional, comma separated, tried in order when one is busy or withdrawn.
# Document scanner (must accept images; thinkingmachines/inkling:free does not
# work: OpenRouter answers 403 "only available on agentic harnesses"):
#   DOCUMENT_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free
# Prohori chat:
#   CHAT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free

# Prohori's knowledge base. The embedding model runs inside this server (no API,
# no cost) and is downloaded on first use. Changing it means re-running
# `npm run seed:faqs`. The default understands Bangla; all-MiniLM-L6-v2 does not.
#   EMBEDDING_MODEL=Xenova/multilingual-e5-small
#   FAQ_MATCH_THRESHOLD=0.79
#   TRANSFORMERS_CACHE_DIR=

# Firebase project that issues the phone-verification ID tokens.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Developer access (prototype only). OFF unless DEV_AUTH_BYPASS=1, and the
# server refuses to boot with it on when NODE_ENV=production. The token is
# whatever you choose; use a long random string, never commit the real one.
DEV_AUTH_BYPASS=
DEV_AUTH_BYPASS_TOKEN=
DEV_AUTH_BYPASS_USER_ID=

# Extra browser origins allowed by CORS (comma separated). Any localhost port is
# already allowed outside production.
CORS_ORIGINS=

# Signs scan results so /api/documents/save can tell they came from this server.
ANALYSIS_SIGNING_SECRET=

# Firebase "phone numbers for testing" (E.164, comma separated: the same numbers
# you added in the Firebase console). They send no SMS, so cost nothing. Up to 50
# accounts can verify the same one at once; the 51st releases the oldest. Real
# numbers stay one account each. Ignored when NODE_ENV=production.
FIREBASE_TEST_PHONES=
